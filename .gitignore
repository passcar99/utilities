
# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# uv
# Keep uv.lock tracked for reproducible applications.
# Ignore only local uv cache/data if stored in the project.
.uv/

# Build and distribution
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Type checking and linting
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs and temporary files
*.log
tmp/
temp/
*.tmp
*.bak
.DS_Store
Thumbs.db

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~

# Local PDF inputs and generated outputs
# Remove these rules if PDFs are intentional project assets.
*.pdf

# Packaging / local config
.python-version.local
